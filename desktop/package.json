{
  "name": "minutetaker",
  "productName": "MinuteTaker",
  "version": "1.0.0",
  "description": "Minutes of meeting and summaries from Teams, Meet, Zoom, Viber and WhatsApp calls",
  "author": "Panagiotis Adamopoulos",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "engine:bundle": "node scripts/bundle-engine.cjs",
    "dist": "npm run build && npm run engine:bundle && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.panosadamop.minutetaker",
    "productName": "MinuteTaker",
    "files": ["dist/**", "electron/**"],
    "extraResources": [{ "from": "engine-dist", "to": "engine", "filter": ["**/*"] }],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "extendInfo": { "NSMicrophoneUsageDescription": "MinuteTaker records your meetings to create minutes." } },
    "linux": { "target": "AppImage" }
  }
}
